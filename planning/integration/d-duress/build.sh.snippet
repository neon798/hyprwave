# INTEGRATION SNIPPET — Model D (duress)
# Paste into build_files/build.sh in the SHARED section (after theme assets is fine).
# This deploys packaging ONLY. It does NOT enable pam_duress in any PAM stack.
#
# Prerequisites:
#   - Containerfile wires duressbuilder and COPY --from=duressbuilder /install/ /
#     (see Containerfile.snippet) OR you install the .so some other way.
#   - Files exist under /ctx/duress/ from the ctx stage (build_files/ is COPY'd as /).

### ---- duress packaging (OFF BY DEFAULT — no PAM enablement) ----
### Module binaries come from duressbuilder stage COPY (pam_duress.so, duress_sign).
### Here we only deploy templates, setup tool, docs, and empty global script dir.

install -d /usr/share/hyprwave/duress/templates
install -d /usr/share/hyprwave/duress/pam.d
install -d /etc/duress.d

# Templates (unsigned). Users copy via hyprwave-duress-setup.
if [ -d /ctx/duress/templates ]; then
	cp -a /ctx/duress/templates/. /usr/share/hyprwave/duress/templates/
	# Templates should be readable; setup tool re-installs as mode 500 when copying.
	find /usr/share/hyprwave/duress/templates -type f -name '*.sh' -exec chmod 0644 {} +
fi

# Reference PAM snippets + security README (documentation only).
if [ -f /ctx/duress/README.md ]; then
	install -m0644 /ctx/duress/README.md /usr/share/hyprwave/duress/README.md
fi
if [ -d /ctx/duress/pam.d ]; then
	cp -a /ctx/duress/pam.d/. /usr/share/hyprwave/duress/pam.d/
fi

# ENABLE.md ships with the image so admins can find enable steps offline.
# Integrator should also copy planning/integration/d-duress/ENABLE.md into the
# ctx tree, e.g. place a copy at build_files/duress/ENABLE.md, or:
#   install -m0644 /ctx/duress/ENABLE.md /usr/share/hyprwave/duress/ENABLE.md
if [ -f /ctx/duress/ENABLE.md ]; then
	install -m0644 /ctx/duress/ENABLE.md /usr/share/hyprwave/duress/ENABLE.md
fi

# Setup tool (opt-in; does not enable PAM).
if [ -f /ctx/duress/hyprwave-duress-setup ]; then
	install -m0755 /ctx/duress/hyprwave-duress-setup /usr/bin/hyprwave-duress-setup
fi

# Global duress script directory exists but is EMPTY (no signed scripts).
# Drop a marker so admins know the path is intentional.
cat >/etc/duress.d/README <<'EOF'
# /etc/duress.d — global pam-duress scripts (run as root when signed password matches)
#
# Stock Hyprwave ships this directory EMPTY and does NOT enable pam_duress.so.
# To configure:
#   1. Enable PAM (see /usr/share/hyprwave/duress/ENABLE.md) — admin decision
#   2. sudo hyprwave-duress-setup --system --wipe-template
#      or install + duress_sign your own scripts here
# Scripts must be mode 500/540/550 with a matching .sha256 from duress_sign.
EOF
chmod 0644 /etc/duress.d/README

# Explicitly do NOT touch:
#   /etc/pam.d/system-auth
#   /etc/pam.d/sddm
#   /etc/pam.d/greetd
#   /etc/pam.d/hyprlock
### ---- end duress packaging ----
