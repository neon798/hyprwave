# --- Model C (C-W1-002): multi-stage Go build for hyprwave-assistant ---
# Merge into Containerfile. Independent of hyprbuilder; usable for hyprland + cosmic.
# Build context must include apps/hyprwave-assistant/.

FROM docker.io/library/golang:1.23-bookworm AS assistant-builder
WORKDIR /src
COPY apps/hyprwave-assistant/go.mod apps/hyprwave-assistant/go.sum ./
RUN go mod download
COPY apps/hyprwave-assistant/ ./
# Static-ish binary; version stamped for About / --version
ARG ASSISTANT_VERSION=0.2.2
ENV CGO_ENABLED=0
RUN go test ./... \
 && go build -trimpath \
      -ldflags="-s -w -X main.version=${ASSISTANT_VERSION}" \
      -o /out/hyprwave-assistant .

# Final image stage (after FROM de-${DE} or equivalent) — one-pass install:
#
#   # binary
#   COPY --from=assistant-builder /out/hyprwave-assistant /usr/bin/hyprwave-assistant
#   RUN chmod 0755 /usr/bin/hyprwave-assistant
#
#   # data + desktop (if not installed via build.sh.snippet)
#   COPY build_files/usr/share/hyprwave/assistant /usr/share/hyprwave/assistant
#   COPY build_files/usr/share/applications/hyprwave-assistant.desktop \
#        /usr/share/applications/hyprwave-assistant.desktop
#   RUN chmod -R a+rX /usr/share/hyprwave/assistant
#
# Runtime default data path: /usr/share/hyprwave/assistant
# Override: HYPRWAVE_ASSISTANT_DATA or --data
# Smoke after image boot:
#   hyprwave-assistant --help
#   hyprwave-assistant --version
#   hyprwave-assistant kb
