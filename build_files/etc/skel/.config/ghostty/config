font-family = JetBrains Mono
font-size = 12
font-feature = calt
font-feature = liga

window-padding-x = 4
window-padding-y = 4
window-decoration = none
window-save-state = always

cursor-style = bar
cursor-style-blink = true

shell-integration = bash
mouse-hide-while-typing = true

copy-on-select = clipboard

confirm-close-surface = false

# Colors come from the active Hyprwave theme (~/.config/ghostty/theme.conf is a
# symlink through ~/.config/hyprwave/theme). '?' = don't error if missing.
config-file = ?theme.conf
